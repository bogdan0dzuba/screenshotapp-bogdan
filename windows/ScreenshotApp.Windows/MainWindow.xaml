<Window x:Class="ScreenshotApp.Windows.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Скриншутер" Width="780" Height="580" MinWidth="510" MinHeight="400"
        WindowStartupLocation="CenterScreen">
    <Grid Margin="24">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <DockPanel LastChildFill="True" Margin="0,0,0,14">
            <Button DockPanel.Dock="Right" Style="{StaticResource PrimaryButton}" Content="Снимок области"
                    Click="CaptureClick" />
            <TextBlock VerticalAlignment="Center" Text="Скриншутер" FontSize="28" FontWeight="SemiBold" />
        </DockPanel>

        <Border Grid.Row="1" Padding="12,9" Background="White" BorderBrush="#D9E0EB"
                BorderThickness="1" CornerRadius="6">
            <WrapPanel VerticalAlignment="Center">
                <TextBlock Text="Хоткей" VerticalAlignment="Center" Margin="0,0,14,0" FontWeight="SemiBold" />
                <CheckBox x:Name="Ctrl" Content="Ctrl" VerticalAlignment="Center" Margin="0,0,10,0" />
                <CheckBox x:Name="Alt" Content="Alt" VerticalAlignment="Center" Margin="0,0,10,0" />
                <CheckBox x:Name="Shift" Content="Shift" VerticalAlignment="Center" Margin="0,0,10,0" />
                <ComboBox x:Name="TriggerKey" Width="58" Margin="0,0,12,0" VerticalAlignment="Center"
                          AutomationProperties.Name="Клавиша хоткея" />
                <Button Content="Применить" Click="ApplyHotKey" />
            </WrapPanel>
        </Border>

        <DockPanel Grid.Row="2" Margin="0,18,0,8">
            <Button DockPanel.Dock="Right" Content="Открыть папку" Click="OpenFolder" />
            <TextBlock Text="Последние снимки" FontSize="20" FontWeight="SemiBold" VerticalAlignment="Center" />
        </DockPanel>

        <ListBox Grid.Row="3" x:Name="Shelf" Background="White" BorderBrush="#D9E0EB" Padding="4"
                 ScrollViewer.HorizontalScrollBarVisibility="Disabled" AutomationProperties.Name="Последние снимки">
            <ListBox.ItemContainerStyle>
                <Style TargetType="ListBoxItem">
                    <Setter Property="HorizontalContentAlignment" Value="Stretch" />
                    <Setter Property="Padding" Value="8,6" />
                </Style>
            </ListBox.ItemContainerStyle>
            <ListBox.ItemTemplate>
                <DataTemplate>
                    <DockPanel>
                        <Button DockPanel.Dock="Right" Content="Копировать" Click="CopyRecent" Margin="12,0,0,0" />
                        <Border DockPanel.Dock="Left" Width="104" Height="58" Background="#E7ECF3" CornerRadius="4"
                                Cursor="Hand" ToolTip="Перетащите PNG в другое приложение"
                                AutomationProperties.Name="Перетащить PNG"
                                PreviewMouseLeftButtonDown="StartFileDrag" PreviewMouseMove="MoveFileDrag"
                                PreviewMouseLeftButtonUp="EndFileDrag">
                            <Image Source="{Binding Thumbnail}" Stretch="Uniform" />
                        </Border>
                        <TextBlock Text="{Binding Name}" VerticalAlignment="Center" Margin="12,0,0,0"
                                   TextTrimming="CharacterEllipsis" />
                    </DockPanel>
                </DataTemplate>
            </ListBox.ItemTemplate>
        </ListBox>
        <TextBlock Grid.Row="3" x:Name="EmptyShelf" Text="После первого снимка здесь появится PNG."
                   HorizontalAlignment="Center" VerticalAlignment="Center" IsHitTestVisible="False" />
        <TextBlock Grid.Row="4" x:Name="Status" TextWrapping="Wrap" Margin="0,10,0,0"
                   AutomationProperties.LiveSetting="Polite" />
    </Grid>
</Window>
