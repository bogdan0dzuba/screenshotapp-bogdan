    <UseWPF>true</UseWPF>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <AssemblyName>ScreenshotApp-Bogdan</AssemblyName>
    <RootNamespace>ScreenshotApp.Windows</RootNamespace>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <Version>0.1.0</Version>
    <Product>Скриншутер</Product>
    <Description>Снимки экрана и редактирование на Windows</Description>
  </PropertyGroup>
  <ItemGroup>
    <InternalsVisibleTo Include="SmokeChecks" />
  </ItemGroup>
</Project>
